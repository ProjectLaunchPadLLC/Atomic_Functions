{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/atomfun/registry_schema.json",
  "title": "Atomfun Function Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "module_path",
    "category",
    "signature",
    "description",
    "source",
    "license",
    "visibility",
    "created_at",
    "updated_at",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Global unique identifier (UUID or prefixed id).",
      "pattern": "^[a-zA-Z0-9_\\-:]+$"
    },
    "name": {
      "type": "string",
      "description": "Globally unique short name in snake_case.",
      "pattern": "^[a-z0-9_]+$"
    },
    "display_name": {
      "type": "string",
      "description": "Human friendly title."
    },
    "module_path": {
      "type": "string",
      "description": "Import path in module:callable or module.callable form."
    },
    "category": {
      "type": "string",
      "description": "Primary controlled category.",
      "examples": ["math", "text", "image", "io", "data"]
    },
    "subcategories": {
      "type": "array",
      "items": { "type": "string" }
    },
    "signature": {
      "type": "object",
      "required": ["inputs", "output"],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "required"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "required": { "type": "boolean" },
              "description": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "output": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "type": "string" },
            "description": { "type": "string" }
          },
          "additionalProperties": false
        },
        "pure": { "type": "boolean" },
        "side_effects": {
          "type": "array",
          "items": { "type": "string" }
        },
        "complexity": { "type": "string" }
      },
      "additionalProperties": false
    },
    "description": {
      "type": "string",
      "description": "Short summary; AI generated and human editable."
    },
    "examples": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 5
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source": {
      "type": "string",
      "description": "Library id or 'core'."
    },
    "contributor_id": {
      "type": "string",
      "description": "Contributor account id."
    },
    "license": {
      "type": "string",
      "description": "SPDX license identifier."
    },
    "visibility": {
      "type": "string",
      "enum": ["public", "org", "private"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "string",
      "description": "Semantic version for the function."
    },
    "usage_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "last_used_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "payout_config": {
      "type": "object",
      "properties": {
        "share_percent": { "type": "number", "minimum": 0, "maximum": 1 },
        "currency": { "type": "string" },
        "min_payout_threshold": { "type": "number", "minimum": 0 },
        "payment_account_id": { "type": "string" },
        "revenue_model": {
          "type": "string",
          "enum": ["per_call", "per_minute", "subscription_share"]
        }
      },
      "additionalProperties": false
    },
    "ai_metadata": {
      "type": "object",
      "properties": {
        "analyzer_version": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "suggested_names": {
          "type": "array",
          "items": { "type": "string" }
        },
        "key_phrases": {
          "type": "array",
          "items": { "type": "string" }
        },
        "generated_description": { "type": "string" },
        "generated_examples": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "category_suggestion": { "type": "string" },
        "quality_flags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "analyzed_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "integrity_hash": {
      "type": "string",
      "description": "Optional code hash for verification (e.g., sha256:...)."
    }
  }
}

